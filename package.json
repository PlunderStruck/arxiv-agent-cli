{
  "name": "arxiv-agent-cli",
  "version": "0.1.0",
  "private": true,
  "description": "A bounded, durable arXiv CLI designed for autonomous coding agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PlunderStruck/arxiv-agent-cli.git"
  },
  "type": "module",
  "bin": {
    "arxiv": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "skills",
    "README.md",
    "install.sh"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-reporter=spec dist/test/*.test.js",
    "verify": "npm run typecheck && npm test && npm pack --dry-run",
    "smoke": "npm run build && ./scripts/upstream-smoke.sh",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@rgrove/parse-xml": "^4.2.3",
    "unpdf": "^1.8.0"
  }
}
